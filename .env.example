# --- Production (obligatoire sur Vercel) ---
# Générer des secrets >= 32 caractères, distincts entre eux.
ADMIN_SECRET=change-me-to-a-strong-secret-min-32-chars
CLIENT_AUTH_SECRET=change-me-client-secret-distinct-min-32-chars
ADMIN_ENFORCE_ROLES=true

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

NEXT_PUBLIC_APP_URL=https://impulcia-afrique.com

# --- Observabilité (recommandé en production) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Supabase (optionnel en dev local) ---
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Admin (optionnel) ---
ADMIN_DEFAULT_ROLE=owner

# --- Webhooks / email (optionnel) ---
WHATSAPP_OUTGOING_WEBHOOK_ENABLED=false
WHATSAPP_OUTGOING_WEBHOOK_URL=
WHATSAPP_OUTGOING_WEBHOOK_TOKEN=
RESEND_API_KEY=
LEADS_CONFIRMATION_FROM_EMAIL=contact@impulcia.com

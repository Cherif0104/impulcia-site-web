# Supabase (optional — in-memory fallback if missing)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis REST (required in production for distributed rate-limit)
# Local/dev only: can be empty to use in-memory fallback
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Admin CRM (required for /admin)
ADMIN_SECRET=change-me-to-a-strong-secret

# Outgoing WhatsApp webhook (optional)
WHATSAPP_OUTGOING_WEBHOOK_ENABLED=false
WHATSAPP_OUTGOING_WEBHOOK_URL=
WHATSAPP_OUTGOING_WEBHOOK_TOKEN=

# Transactional email confirmations (optional)
RESEND_API_KEY=
LEADS_CONFIRMATION_FROM_EMAIL=contact@impulcia.com
